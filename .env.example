# =============================================================================
# Pulse FX - variaveis de ambiente
#
# Copie este arquivo para `.env` na raiz do repositorio e ajuste o que precisar.
# O unico valor que voce PRECISA preencher e FRED_API_KEY.
# =============================================================================

# -----------------------------------------------------------------------------
# OBRIGATORIO
# -----------------------------------------------------------------------------

# Chave da API do FRED (Federal Reserve Economic Data).
# Registro gratuito e imediato: https://fredaccount.stlouisfed.org/apikeys
# Sem ela as series americanas (US 10Y, Fed Funds, Dollar Index, US CPI) nao
# sincronizam; as series do BCB continuam funcionando normalmente.
FRED_API_KEY=

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse_fx
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Portas expostas no host
# -----------------------------------------------------------------------------
API_PORT=3333
WEB_PORT=5173

# URL da API embutida no bundle do frontend em tempo de BUILD.
# Precisa ser um endereco alcancavel pelo NAVEGADOR, nao pela rede do Docker.
VITE_API_URL=http://localhost:3333

# -----------------------------------------------------------------------------
# Seguranca
# -----------------------------------------------------------------------------

# Bearer token do endpoint POST /api/admin/sync.
# Troque em qualquer ambiente que nao seja a sua maquina.
ADMIN_TOKEN=pulse-fx-dev-admin-token

# Origens permitidas no CORS. `*` serve para desenvolvimento local.
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Politica de sincronizacao
# -----------------------------------------------------------------------------

# Janela minima entre duas sincronizacoes bem-sucedidas do MESMO indicador.
# E o principal freio contra chamadas redundantes as APIs publicas.
SYNC_TTL_MINUTES=30

# Sincronizar assim que o worker sobe. Deixe `true` para que o ambiente novo
# tenha dado na tela sem nenhum passo manual.
SYNC_ON_BOOTSTRAP=true

# Quantos dias para tras cada sync incremental relê. Existe porque IPCA e CPI
# sao REVISADOS depois de publicados.
SYNC_REVISION_WINDOW_DAYS=5

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
LOG_LEVEL=info
